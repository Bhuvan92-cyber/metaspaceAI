# Database URL (SQLite for local, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Token Vault AES-256 Secret (Used to encrypt Meta OAuth Access Tokens at rest)
TOKEN_VAULT_SECRET="metasphere_vault_master_key_2026_super_secure_32bytes"

# Meta Graph API & OAuth Configuration (Optional for Live Mode, Mock works out of the box)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="metasphere_secure_webhook_verify_token"

# WhatsApp Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Google Gemini AI API Key
GEMINI_API_KEY=""

# Application Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
